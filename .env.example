# Prefer Raptor Mini when configured. If your Raptor endpoint is available, fill these in.
RAPTOR_MINI_API_KEY=
RAPTOR_MINI_MODEL=raptor-mini
RAPTOR_MINI_BASE_URL=https://your-raptor-endpoint/v1

# Fallback to OpenAI if Raptor Mini is not configured.
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
